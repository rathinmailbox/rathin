// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A blog post / article.
model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String   @default("") // Markdown body
  coverImage  String?
  author      String   @default("Rathin")
  category    String   @default("General")
  tags        String   @default("") // comma-separated tags
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([createdAt])
}

// Editable site-wide settings (one row, id = "default").
model SiteSetting {
  id        String   @id @default("default")
  siteName  String   @default("rathin.")
  tagline   String   @default("A blog on critical thought and populist politics.")
  about     String   @default("# About\n\nWelcome to my blog. I write here bimonthly, of which my chosen definition of "bimonthly" varies by my whim. Conatined here are my inchoate thoughts on heterodox economics, legal theory, sociology, and technology (sometimes all at once). I hope you find the content edifying and the prose bareable.")
  accent    String   @default("#c1272d") // hex accent color
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
